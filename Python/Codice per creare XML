import re
import sys
from html import escape


# ══════════════════════════════════════════════════════════════
# CONFIGURAZIONE DELLE CATEGORIE
# ══════════════════════════════════════════════════════════════
#
# Per aggiungere una nuova categoria NON serve modificare il parser:
# - per una nuova subordinata, aggiungila alla famiglia opportuna qui sotto;
# - per una nuova coordinata, aggiungila a COORDINATE_TYPES;
# - anche una categoria non registrata viene comunque accettata: il parser
#   la conserva e genera automaticamente un'abbreviazione per l'id XML.

SUBORDINATE_FAMILIES = {
    'completiva': {
        'oggettiva': 'comp_obj',
        'soggettiva': 'comp_sogg',
        'dichiarativa': 'dich',
        'interrogativa indiretta': 'int_ind',
    },
    'relativa': {
        'relativa': 'rel',
    },
    'circostanziale': {
        'temporale': 'temp',
        'causale': 'caus',
        'finale': 'fin',
        'consecutiva': 'cons',
        'condizionale': 'cond',
        'concessiva': 'conc',
        'comparativa': 'compar',
        'modale': 'mod',
        # Tipi legacy / opzionali: mantenuti per retrocompatibilità.
        'limitativa': 'lim',
        'avversativa': 'avv',
    },
}

COORDINATE_TYPES = {
    'copulativa': 'coord_cop',
    'disgiuntiva': 'coord_dis',
    'avversativa': 'coord_avv',
    'conclusiva': 'coord_concl',
    'esplicativa': 'coord_esp',
}

# Alias accettati nell'input vecchio o in forme più verbose.
SUBTYPE_ALIASES = {
    'completiva oggettiva': ('completiva', 'oggettiva'),
    'oggettiva': ('completiva', 'oggettiva'),
    'completiva soggettiva': ('completiva', 'soggettiva'),
    'soggettiva': ('completiva', 'soggettiva'),
    'dichiarativa': ('completiva', 'dichiarativa'),
    'interrogativa indiretta': ('completiva', 'interrogativa indiretta'),
    'relativa': ('relativa', 'relativa'),
    'temporale': ('circostanziale', 'temporale'),
    'causale': ('circostanziale', 'causale'),
    'finale': ('circostanziale', 'finale'),
    'consecutiva': ('circostanziale', 'consecutiva'),
    'condizionale': ('circostanziale', 'condizionale'),
    'concessiva': ('circostanziale', 'concessiva'),
    'comparativa': ('circostanziale', 'comparativa'),
    'modale': ('circostanziale', 'modale'),
    'limitativa': ('circostanziale', 'limitativa'),
    'avversativa': ('circostanziale', 'avversativa'),
}

MODE_MAP = {
    'e': 'esplicita',
    'i': 'implicita',
    's': 'sottintesa',
}

VERBAL_FORM_ALIASES = {
    'inf': 'infinito',
    'infinito': 'infinito',
    'ger': 'gerundio',
    'gerundio': 'gerundio',
    'part': 'participio',
    'participio': 'participio',
    'fin': 'finita',
    'finita': 'finita',
    'ell': 'ellissi',
    'ellissi': 'ellissi',
}


def _norm(s):
    return re.sub(r'\s+', ' ', (s or '').strip().lower())


def _slug(s, maxlen=18):
    s = _norm(s)
    s = re.sub(r'[^a-z0-9àèéìòù]+', '_', s, flags=re.IGNORECASE).strip('_')
    return (s or 'x')[:maxlen]


def _to_roman(n):
    vals = [
        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),
        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),
        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'), (1, 'I')
    ]
    result = ''
    for v, r in vals:
        while n >= v:
            result += r
            n -= v
    return result


def _is_roman(s):
    return bool(re.fullmatch(r'[IVXLCDM]+', (s or '').strip()))


def _is_mode(s):
    s = (s or '').strip()
    return s in MODE_MAP


def _parse_verbal_form(token):
    token = _norm(token)
    if token.startswith('vf='):
        token = token[3:].strip()
    elif token.startswith('forma-verbale='):
        token = token.split('=', 1)[1].strip()
    else:
        return None
    return VERBAL_FORM_ALIASES.get(token, token)


def infer_subordinate_family_and_subtype(label_tail):
    """
    Accetta, tra le altre:
      subordinata completiva oggettiva
      subordinata oggettiva
      subordinata circostanziale comparativa
      subordinata comparativa
      subordinata relativa

    Se una nuova categoria non è registrata ma è scritta con una famiglia
    esplicita (es. 'subordinata circostanziale eccettuativa'), viene mantenuta.
    """
    tail = _norm(label_tail)
    if not tail:
        return None, None

    for family in SUBORDINATE_FAMILIES:
        prefix = family + ' '
        if tail == family:
            subtype = family if family == 'relativa' else None
            return family, subtype
        if tail.startswith(prefix):
            subtype = tail[len(prefix):].strip() or None
            return family, subtype

    if tail in SUBTYPE_ALIASES:
        return SUBTYPE_ALIASES[tail]

    # Nuovo sottotipo non registrato: lo conserviamo senza bloccare l'utente.
    return 'altro', tail


def subordinate_abbr(family, subtype):
    family = _norm(family)
    subtype = _norm(subtype)
    if family in SUBORDINATE_FAMILIES and subtype in SUBORDINATE_FAMILIES[family]:
        return SUBORDINATE_FAMILIES[family][subtype]
    return 'sub_' + _slug(subtype or family, 14)


def coordinate_abbr(coord_type):
    coord_type = _norm(coord_type)
    return COORDINATE_TYPES.get(coord_type, 'coord_' + _slug(coord_type or 'gen', 12))


# ══════════════════════════════════════════════════════════════
# 1. PARSING INPUT
# ══════════════════════════════════════════════════════════════

def parse_input(text):
    text_match = re.search(r'===TEXT===\s*\n(.*?)\n===ANALYSIS===', text, re.DOTALL)
    analysis_match = re.search(r'===ANALYSIS===(.*?)$', text, re.DOTALL)
    if not (text_match and analysis_match):
        raise ValueError('Format non corretto: servono ===TEXT=== e ===ANALYSIS===')

    text_lines = text_match.group(1).strip().splitlines()
    if not text_lines:
        raise ValueError('Sezione TEXT vuota')

    period_id = text_lines[0].strip().replace('.', '_')
    full_text = '\n'.join(text_lines[1:]).strip()
    full_text = re.sub(r'^[IVXLCDM]+\.\s*', '', full_text)

    analysis_lines = [
        l.strip() for l in analysis_match.group(1).strip().splitlines()
        if l.strip() and not l.lstrip().startswith('#')
    ]
    return period_id, full_text, analysis_lines


def parse_label(label):
    """Restituisce type/family/subtype/coord_type dal primo campo descrittivo."""
    label = _norm(label)

    if label == 'principale' or label.startswith('principale '):
        return 'principale', None, None, None

    if label == 'coordinata' or label.startswith('coordinata '):
        tail = label[len('coordinata'):].strip()
        coord_type = tail or None
        return 'coordinata', None, None, coord_type

    if label == 'subordinata' or label.startswith('subordinata '):
        tail = label[len('subordinata'):].strip()
        family, subtype = infer_subordinate_family_and_subtype(tail)
        return 'subordinata', family, subtype, None

    # Retrocompatibilità: se manca la parola "subordinata", proviamo a
    # interpretare il label come sottotipo noto.
    if label in SUBTYPE_ALIASES:
        family, subtype = SUBTYPE_ALIASES[label]
        return 'subordinata', family, subtype, None

    raise ValueError(f"Categoria non riconoscibile: '{label}'")


def parse_analysis_line(line):
    if '=' not in line:
        raise ValueError(f"Linea invalida: {line}")

    text, rest = line.split('=', 1)
    text = text.strip()
    rest = rest.strip()

    parent_match = re.search(r'\[([^\]]+)\]', rest)
    parent_info = parent_match.group(1).strip() if parent_match else None

    phenomena = []
    for block in re.findall(r'\{([^{}]+)\}', rest):
        phenomena.extend([_norm(x) for x in block.split(';') if _norm(x)])

    without_parent = re.sub(r'\[[^\]]+\]', '', rest)
    without_phenomena = re.sub(r'\{[^{}]+\}', '', without_parent)

    disamb_match = re.search(r'\((\d+)\)', without_phenomena)
    disambiguator = int(disamb_match.group(1)) if disamb_match else None
    rest_clean = re.sub(r'\(\d+\)', '', without_phenomena).strip().rstrip(', ')

    parts = [p.strip() for p in rest_clean.split(',') if p.strip()]
    if not parts:
        raise ValueError(f"Manca la categoria sintattica: {line}")

    prop_type, family, subtype, coord_type = parse_label(parts[0])

    level = '0' if prop_type == 'principale' else None
    mode = None
    verbal_form = None

    for p in parts[1:]:
        ps = p.strip()
        if _is_mode(ps):
            mode = MODE_MAP[ps]
        elif _is_roman(ps):
            level = ps
        else:
            vf = _parse_verbal_form(ps)
            if vf:
                verbal_form = vf

    return {
        'text': text,
        'type': prop_type,
        'family': family,
        'subtype': subtype,
        'coord_type': coord_type,
        'level': level,
        'mode': mode,
        'verbal_form': verbal_form,
        'phenomena': phenomena,
        'parent': parent_info,
        'disambiguator': disambiguator,
        'segments': [],
    }


# ══════════════════════════════════════════════════════════════
# 2. TROVA PADRE
# ══════════════════════════════════════════════════════════════

def parse_parent_descriptor(parent_desc):
    if not parent_desc:
        return None

    tokens = [t.strip() for t in parent_desc.split(',') if t.strip()]
    if not tokens:
        return None

    label = tokens[0]
    target_type, target_family, target_subtype, target_coord_type = parse_label(label)

    target_disamb = None
    target_level = None
    target_mode = None

    for t in tokens:
        d = re.search(r'\((\d+)\)', t)
        if d:
            target_disamb = int(d.group(1))
        clean = re.sub(r'\(\d+\)', '', t).strip()
        if _is_mode(clean):
            target_mode = MODE_MAP[clean]
        elif _is_roman(clean):
            target_level = clean

    return {
        'type': target_type,
        'family': target_family,
        'subtype': target_subtype,
        'coord_type': target_coord_type,
        'level': target_level,
        'mode': target_mode,
        'disambiguator': target_disamb,
    }


def _entry_matches_descriptor(entry, desc):
    if entry['type'] != desc['type']:
        return False

    if desc['type'] == 'subordinata':
        if desc['family'] and entry.get('family') != desc['family']:
            return False
        if desc['subtype'] and entry.get('subtype') != desc['subtype']:
            return False

    if desc['type'] == 'coordinata':
        if desc['coord_type'] and entry.get('coord_type') != desc['coord_type']:
            return False

    if desc['level'] and entry.get('level') and entry['level'] != desc['level']:
        return False

    if desc['mode'] and entry.get('mode') and entry['mode'] != desc['mode']:
        return False

    return True


def find_parent_index(parent_desc, entries):
    if not parent_desc:
        return None

    desc = parse_parent_descriptor(parent_desc)
    matches = [i for i, e in enumerate(entries) if _entry_matches_descriptor(e, desc)]

    if not matches:
        return None

    d = desc['disambiguator']
    if d:
        return matches[d - 1] if d <= len(matches) else None

    return matches[0]


# ══════════════════════════════════════════════════════════════
# 3. SEGMENTAZIONE
# ══════════════════════════════════════════════════════════════

def build_segments(full_text, entries):
    pieces = []

    # Conserviamo il comportamento precedente: la principale può essere
    # discontinua e viene quindi spezzata sulle virgole dichiarate nell'input.
    for ei, entry in enumerate(entries):
        raw = entry['text'].strip()

        # Il carattere | può essere usato nell'ANALYSIS per dichiarare
        # esplicitamente una proposizione discontinua, a qualunque livello:
        #   che, | quella republica, | convenire andare sciancata = ...
        # Se | non è presente, resta compatibile il vecchio comportamento per
        # la principale, che viene spezzata sulle virgole indicate.
        if '|' in raw:
            chunks = [c.strip() for c in raw.split('|') if c.strip()]
        elif entry['type'] == 'principale':
            chunks = [c.strip() for c in raw.split(',') if c.strip()]
        else:
            chunks = [raw]

        for chunk in chunks:
            search = chunk.rstrip('.,;:!?').strip()
            if not search:
                continue

            # Tutte le occorrenze: scegliamo poi quella non ancora occupata.
            starts = [m.start() for m in re.finditer(re.escape(search), full_text, re.IGNORECASE)]
            for pos in starts:
                end = pos + len(search)

                if entry['type'] == 'principale':
                    while end < len(full_text) and full_text[end] in '.,;:!?':
                        end += 1
                else:
                    trailing = chunk[len(search):]
                    for ch in trailing:
                        if end < len(full_text) and full_text[end] == ch:
                            end += 1

                pieces.append((pos, end, ei, chunk))

    # Sceglie una sola occorrenza per ogni chunk, privilegiando l'ordine testuale
    # e impedendo sovrapposizioni. Questo evita che testi ripetuti puntino sempre
    # alla prima occorrenza del periodo.
    pieces.sort(key=lambda x: (x[0], x[1]))
    used_entry_chunks = set()
    filtered = []
    occupied = []

    for s, e, ei, chunk in pieces:
        key = (ei, chunk.lower())
        if key in used_entry_chunks:
            continue
        if any(not (e <= os or s >= oe) for os, oe in occupied):
            continue
        filtered.append((s, e, ei))
        occupied.append((s, e))
        used_entry_chunks.add(key)

    filtered.sort(key=lambda x: x[0])

    segments = []
    for s, e, ei in filtered:
        seg = full_text[s:e]
        segments.append(seg)
        entries[ei]['segments'].append(seg)

    return segments


# ══════════════════════════════════════════════════════════════
# 4. GROUP IDS
# ══════════════════════════════════════════════════════════════

def _unique_id(base, used):
    if base not in used:
        return base
    n = 2
    while f'{base}_{n}' in used:
        n += 1
    return f'{base}_{n}'


def build_group_ids(period_id, entries):
    ids = {}
    used = set()

    for idx, entry in enumerate(entries):
        t = entry['type']

        if t == 'principale':
            base = f'{period_id}_g_main'

        elif t == 'subordinata':
            abbr = subordinate_abbr(entry.get('family'), entry.get('subtype'))
            lev = entry['level'] or 'I'
            base = f'{period_id}_g_{abbr}_{lev}'

        elif t == 'coordinata':
            c_abbr = coordinate_abbr(entry.get('coord_type'))
            pi = find_parent_index(entry['parent'], entries)
            if pi is not None:
                parent = entries[pi]
                if parent['type'] == 'principale':
                    base = f'{period_id}_g_{c_abbr}_main'
                elif parent['type'] == 'subordinata':
                    p_abbr = subordinate_abbr(parent.get('family'), parent.get('subtype'))
                    p_lev = parent['level'] or 'I'
                    base = f'{period_id}_g_{c_abbr}_{p_abbr}_{p_lev}'
                else:
                    base = f'{period_id}_g_{c_abbr}_{idx + 1}'
            else:
                base = f'{period_id}_g_{c_abbr}_{idx + 1}'
        else:
            base = f'{period_id}_g_{idx + 1}'

        gid = _unique_id(base, used)
        used.add(gid)
        ids[idx] = gid

    return ids


# ══════════════════════════════════════════════════════════════
# 5. ETICHETTE E ATTRIBUTI XML
# ══════════════════════════════════════════════════════════════

def canonical_subordinate_label(entry):
    family = entry.get('family')
    subtype = entry.get('subtype')

    if family == 'completiva' and subtype:
        return f'subordinata completiva {subtype}'
    if family == 'relativa':
        return 'subordinata relativa'
    if family == 'circostanziale' and subtype:
        # Mantiene il lessico già usato dal front-end: "subordinata causale",
        # "subordinata comparativa" ecc. La famiglia resta nell'attributo family.
        return f'subordinata {subtype}'
    if subtype:
        return f'subordinata {subtype}'
    return 'subordinata'


def build_type_attr(entry, entries):
    t = entry['type']
    if t == 'principale':
        return 'principale'
    if t == 'subordinata':
        return canonical_subordinate_label(entry)
    if t == 'coordinata':
        pi = find_parent_index(entry['parent'], entries)
        if pi is not None:
            parent_type = build_type_attr(entries[pi], entries)
            return f'coordinata alla {parent_type}'
        return 'coordinata'
    return t


def xml_attr(name, value):
    if value is None or value == '':
        return ''
    return f' {name}="{escape(str(value), quote=True)}"'


# ══════════════════════════════════════════════════════════════
# 6. GENERAZIONE XML
# ══════════════════════════════════════════════════════════════

def generate_xml(period_id, segments, entries):
    out = []
    out.append(f'  <period id="{escape(period_id, quote=True)}" type="periodo">')
    out.append(f'    <prop id="{escape(period_id, quote=True)}_p_all" type="full">')

    for i, seg in enumerate(segments, 1):
        s = seg if seg.startswith(' ') else ' ' + seg
        out.append(f'      <seg id="{escape(period_id, quote=True)}_seg{i}">{escape(s)}</seg>')

    out.append('    </prop>')
    out.append('')

    gids = build_group_ids(period_id, entries)

    for idx, entry in enumerate(entries):
        gid = gids[idx]
        xtype = build_type_attr(entry, entries)

        level = entry['level']
        pi = None
        if entry['type'] == 'coordinata':
            pi = find_parent_index(entry['parent'], entries)
            level = entries[pi]['level'] if pi is not None else level

        parent_gid = None
        if entry['parent']:
            pi = find_parent_index(entry['parent'], entries)
            if pi is not None:
                parent_gid = gids[pi]

        attrs = ''
        attrs += xml_attr('id', gid)
        attrs += xml_attr('type', xtype)
        attrs += xml_attr('relation', entry['type'])
        attrs += xml_attr('family', entry.get('family'))
        attrs += xml_attr('subtype', entry.get('subtype'))
        attrs += xml_attr('coordType', entry.get('coord_type'))
        attrs += xml_attr('level', level)
        attrs += xml_attr('mode', entry.get('mode'))
        attrs += xml_attr('verbalForm', entry.get('verbal_form'))
        attrs += xml_attr('phenomena', '; '.join(entry.get('phenomena') or []))
        attrs += xml_attr('parent', parent_gid)

        out.append(f'    <group{attrs}>')

        emitted = set()
        for seg_text in entry['segments']:
            for si, seg in enumerate(segments):
                if si in emitted:
                    continue
                if seg.lower().strip() == seg_text.lower().strip():
                    out.append(f'      <member ref="{escape(period_id, quote=True)}_seg{si + 1}"/>')
                    emitted.add(si)
                    break

        out.append('    </group>')
        out.append('')

    out.append('  </period>')
    return '\n'.join(out)


# ══════════════════════════════════════════════════════════════
# MAIN
# ══════════════════════════════════════════════════════════════


def print_categories():
    print('SUBORDINATE:')
    for family, subtypes in SUBORDINATE_FAMILIES.items():
        print(f'  {family}:')
        for subtype in subtypes:
            print(f'    - {subtype}')
    print('COORDINATE:')
    for coord_type in COORDINATE_TYPES:
        print(f'  - {coord_type}')
    print('\nNota: i nuovi sottotipi espliciti vengono accettati anche se non registrati.')

if __name__ == '__main__':
    if '--categories' in sys.argv:
        print_categories()
        sys.exit(0)

    filename = sys.argv[1] if len(sys.argv) > 1 else 'input.txt'

    try:
        with open(filename, 'r', encoding='utf-8') as f:
            input_text = f.read()
    except FileNotFoundError:
        print(f"ERRORE: file '{filename}' non trovato.")
        print('Uso: python generate_xml.py [nome_file]')
        sys.exit(1)

    try:
        period_id, full_text, analysis_lines = parse_input(input_text)
        entries = [parse_analysis_line(line) for line in analysis_lines]
        segments = build_segments(full_text, entries)
        print(generate_xml(period_id, segments, entries))
    except ValueError as exc:
        print(f'ERRORE DI PARSING: {exc}', file=sys.stderr)
        sys.exit(2)
